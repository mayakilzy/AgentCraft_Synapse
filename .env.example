# ─── AgentCraft Synapse — sample environment ──────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the filled `.env`.
# This file contains no secrets by design.

# ── Runtime profile ──────────────────────────────────────────────────────────
# development  — local dev: permissive auth adapter, CORS allowlist enabled
# test         — pytest: in-memory SQLite, all external calls stubbed
# production   — fail-closed: real auth provider required, CORS explicit
SYNAPSE_ENV=development

# ── Application ───────────────────────────────────────────────────────────────
SYNAPSE_APP_NAME=AgentCraft Synapse
SYNAPSE_LOG_LEVEL=INFO
SYNAPSE_REQUEST_ID_HEADER=X-Request-ID

# ── Database ──────────────────────────────────────────────────────────────────
# Use postgresql+psycopg://user:pass@host:5432/synapse in production.
# Use sqlite+aiosqlite:///:memory: or file:./synapse.db in dev/test.
SYNAPSE_DB_URL=sqlite+aiosqlite:///./synapse.db
SYNAPSE_DB_ECHO=false
SYNAPSE_DB_POOL_SIZE=5
SYNAPSE_DB_MAX_OVERFLOW=10
SYNAPSE_DB_CONNECT_TIMEOUT=5

# ── Auth (development adapter) ────────────────────────────────────────────────
# In dev mode, SYNAPSE_DEV_API_KEYS is a comma-separated list of static keys.
# Leave EMPTY in production — production must fail-closed if no provider configured.
SYNAPSE_AUTH_MODE=development
SYNAPSE_DEV_API_KEYS=
# Comma-separated list of admin API keys (privileged endpoints)
SYNAPSE_ADMIN_API_KEYS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist. NEVER use "*" with credentials.
SYNAPSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SYNAPSE_CORS_ALLOW_CREDENTIALS=true

# ── Rate limiting (in-process token bucket) ───────────────────────────────────
SYNAPSE_RATE_LIMIT_PER_MINUTE=120
SYNAPSE_RATE_LIMIT_BURST=20

# ── SSRF protection ──────────────────────────────────────────────────────────
SYNAPSE_SSRF_ALLOW_PRIVATE=false
SYNAPSE_SSRF_FETCH_TIMEOUT_SECONDS=10
SYNAPSE_SSRF_MAX_RESPONSE_BYTES=10485760

# ── Observability ─────────────────────────────────────────────────────────────
SYNAPSE_LOG_JSON=false
SYNAPSE_OTEL_EXPORTER=
